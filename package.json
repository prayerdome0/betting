{
  "name": "nexus-trading-simulation",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "worker": "node --env-file-if-exists=.env.local --import tsx scripts/worker.ts",
    "test": "tsx --experimental-test-module-mocks --test tests/*.test.ts",
    "test:integration": "tsx --test tests/*.integration.ts",
    "emulators": "firebase emulators:start --project demo-nexus --only auth,firestore --import=.firebase-data --export-on-exit=.firebase-data",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts tests *.ts *.mjs *.json",
    "admin:grant": "node --env-file-if-exists=.env.local --import tsx scripts/set-admin.ts",
    "doctor": "node --env-file-if-exists=.env.local --import tsx scripts/doctor.ts"
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "firebase-admin": "^14.4.0",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.1.17",
    "@types/jsdom": "^30.0.0",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.5",
    "firebase-tools": "^15.30.2",
    "jsdom": "^30.1.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  },
  "overrides": {
    "gaxios": {
      "uuid": "^11.1.1"
    }
  }
}
