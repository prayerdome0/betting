rules_version = '2';

// Xacheus Betting — Firestore security rules.
// Deploy with:  firebase deploy --only firestore:rules
// (requires the Firebase CLI + a linked project:  firebase use xacheus-339ba)

service cloud.firestore {
  match /databases/{database}/documents {

    // Every user owns their wallet + payment references, and only they
    // can read/write them. Auth is required for any access.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
