# --- Xacheus Betting ---

# The Odds API key (https://the-odds-api.com) — powers the Sportsbook with
# real bookmaker odds. Free tier: 500 requests/month.
# If unset, users can paste a key in the in-app Settings (⚙) panel.
ODDS_API_KEY=

# Stripe secret key (sk_test_... / sk_live_...) — enables real card deposits
# via Stripe Checkout. If unset, deposits run in sandbox mode (instant
# credit, no real charge).
STRIPE_SECRET_KEY=

# Used for Stripe success/cancel redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: PostgreSQL connection for a persistent server-side ledger
# (the src/db Drizzle schema is ready).
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
