# =============================================================================
# Browser (client) Firebase configuration — PUBLIC identifiers, not secrets.
# Security comes from Authentication + Firestore rules, never from hiding these.
# Set all of them together when pointing the site at a different project; a
# partial override silently mixes two Firebase projects.
# =============================================================================
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCl3C2YsBc5r7WS8HRyAtxc5r4LoC4OFfs
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ai-health-d2c5b.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ai-health-d2c5b
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=ai-health-d2c5b.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1018985914953
NEXT_PUBLIC_FIREBASE_APP_ID=1:1018985914953:web:3317363b3be4ad57299598

# Public Web Push key, reserved for a future Firebase Messaging integration.
# Setting this alone does not enable push notifications; no messaging service
# worker, token registration, or notification sender is implemented yet.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=BIItyMkBqlNkUOzc26w4O96ej2Rc_Y1O2EXr1WgTq3nxEDrrnixjsyWbKzBYrP3v1E8A1kjpZc6arkaw4QBZOr4

# =============================================================================
# Server identity — REQUIRED.
# Firestore rules deny every client write, so the account document that is
# created right after sign-up can only be written by this server. Without a
# credential here, registration and login succeed in the browser but the
# dashboard can never initialize (HTTP 503 from /api/command).
# Must point at the SAME project as NEXT_PUBLIC_FIREBASE_PROJECT_ID.
# =============================================================================
FIREBASE_PROJECT_ID=ai-health-d2c5b

# Option A (recommended for Vercel and other serverless hosts): the complete
# service account key file as ONE JSON value.
# Revoke any key shared in chat. Configure a replacement directly in your
# hosting provider's secret settings, never in this tracked template.
# Firebase console -> Project settings -> Service accounts -> Generate new
# private key. Give that account Firestore data access and Firebase Auth token
# verification only. Keep it out of Git and out of every NEXT_PUBLIC_* variable.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"ai-health-d2c5b","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxx@ai-health-d2c5b.iam.gserviceaccount.com"}

# Option B: the same credential split across variables (a PEM with literal \n
# sequences is accepted and normalized).
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@ai-health-d2c5b.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_PRIVATE_KEY_ID=0123456789abcdef

# Option C: workload identity (recommended on GCP/Cloud Run) or an external
# credential file. Never place the file in this repository.
# GOOGLE_APPLICATION_CREDENTIALS=/secure/path/service-account.json

# =============================================================================
# Local-only alternative: use ALL four values together, plus npm run emulators.
# This uses real Firebase emulators; it does NOT connect to the production project.
# =============================================================================
# NEXT_PUBLIC_FIREBASE_EMULATORS=true
# FIREBASE_PROJECT_ID=demo-nexus
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
