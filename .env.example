# --- Xacheus Betting ---

# OnTech payment gateway (https://payments.ontech.co.zm) — powers Mobile
# Money deposits (MTN/Airtel/Zamtel). Copy your real values into .env.local.
PAYMENT_GATEWAY_BASE_URL=https://payments.ontech.co.zm/api/v1
PAYMENT_GATEWAY_API_KEY=op_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYMENT_GATEWAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional second signing secret if your gateway signs with a different key.
PAYMENT_GATEWAY_SIGNING_SECRET=

# Stripe secret key (sk_test_... / sk_live_...) — enables card deposits via
# Stripe Checkout. If unset, card deposits run in sandbox mode.
STRIPE_SECRET_KEY=

# The Odds API key (https://the-odds-api.com) — powers the Sportsbook with
# real bookmaker odds. Free tier: 500 requests/month.
# If unset, users can paste a key in the in-app Settings (⚙) panel.
ODDS_API_KEY=

# Used for Stripe success/cancel redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: PostgreSQL connection for a persistent server-side ledger
# (the src/db Drizzle schema is ready).
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Firebase (Auth + Firestore) ---
# The app ships with the Xacheus Firebase project baked in (safe to expose —
# security comes from Auth + Firestore rules). Create your own project at
# console.firebase.google.com and set these to point at it instead.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyARQx_UMUz0Q2w3aggfE46WBxzli1ChziQ
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=xacheus-339ba.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=xacheus-339ba
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=xacheus-339ba.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=246733468580
NEXT_PUBLIC_FIREBASE_APP_ID=1:246733468580:web:fa0a7693a35709b2f40731
